# ---------------------------------------------------------------------------
# Fortbildungs-Tool Schulamt Memmingen-Unterallgäu
# Kopiere diese Datei nach .env und trage echte Werte ein.
# .env selbst gehört NICHT ins Git-Repository.
# ---------------------------------------------------------------------------

# PostgreSQL-Verbindung
# Lokal (Homebrew):  postgresql://<user>@localhost:5432/fortbildungen_uamm?schema=public
# Docker:            postgresql://fortbildungen:<passwort>@db:5432/fortbildungen_uamm?schema=public
DATABASE_URL="postgresql://postgres@localhost:5432/fortbildungen_uamm?schema=public"

# Docker Compose
# Image, das die GitHub Action bei jedem Push auf main in GHCR veröffentlicht.
APP_IMAGE="ghcr.io/bastimuensch/fortbildungenuamm:latest"
# Passwort des PostgreSQL-Containers. Erzeugen mit: openssl rand -hex 32
POSTGRES_PASSWORD="bitte-durch-einen-zufaelligen-wert-ersetzen"

# Signaturschlüssel für die Session-Cookies (JWT, HS256).
# Erzeugen mit:  openssl rand -base64 48
# Wird der Wert geändert, sind alle bestehenden Sessions ungültig.
JWT_SECRET="bitte-durch-einen-zufaelligen-wert-ersetzen"

# Öffentliche Basis-URL (für ICS-Feed und absolute Links in Exporten).
# Lokal mit `npm run dev`: http://localhost:3000
# Docker veröffentlicht die App auf Port 3001; produktiv hier die öffentliche
# HTTPS-Adresse eintragen, nicht das interne Newt/Pangolin-Ziel.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Erst-Admin, wird beim Seed angelegt (danach Passwort in der App ändern)
SEED_ADMIN_EMAIL="admin@schulamt-uamm.de"
SEED_ADMIN_PASSWORD="bitte-aendern"
SEED_ADMIN_NAME="Medienteam UAMM"

# ---------------------------------------------------------------------------
# FIBS-Import
# ---------------------------------------------------------------------------
# Der Import ist standardmäßig AUS. Vor dem Aktivieren die Nutzungsbedingungen
# von FIBS und die robots.txt prüfen (siehe README, Abschnitt FIBS-Import).
FIBS_IMPORT_ENABLED="false"
FIBS_BASE_URL="https://fibs.alp.dillingen.de"
# Kontaktadresse im User-Agent, damit der Betreiber uns erreichen kann
FIBS_USER_AGENT_CONTACT="medienteam@schulamt-uamm.de"

# ---------------------------------------------------------------------------
# DSGVO-Löschlauf
# ---------------------------------------------------------------------------
# "off" deaktiviert den automatischen Löschlauf (nur für lokale Entwicklung).
RETENTION_SCHEDULER="on"
# Optionales Bearer-Token, um den Löschlauf extern via Cron anzustoßen
# Erzeugen mit:  openssl rand -hex 32
CRON_SECRET=""
