// Datenmodell Fortbildungs-Tool Schulamt Memmingen-Unterallgäu (UAMM)
//
// Konvention: Für aufzählbare Werte werden bewusst KEINE Prisma-Enums benutzt,
// sondern String-Felder mit einem Kommentar über die erlaubten Werte. Die
// Durchsetzung passiert zentral in den zod-Schemata unter src/lib/validation.
// Grund: Ein neuer Wert (z. B. eine weitere Schulart) ist dann eine
// Code-Änderung statt einer Datenbank-Migration.
//
// Die Konstanten dazu liegen in src/constants/ — dort und nur dort werden
// Werte gepflegt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Redaktion / Zugang
// ---------------------------------------------------------------------------

model User {
  id String @id @default(uuid())

  email          String    @unique
  /// Leer, solange der Zugang eingerichtet, aber noch kein Passwort gesetzt
  /// wurde. Eine Anmeldung ist dann nicht möglich.
  passwordHash   String?
  name           String?
  role           String // RVS | ADMIN | REDAKTEUR | REFERENT
  isActive       Boolean   @default(true)
  /// Wird bei einem Passwortwechsel erhöht. JWTs mit einer älteren Version
  /// verlieren dadurch beim nächsten serverseitigen Zugriff ihre Gültigkeit.
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  fortbildungen                       Fortbildung[]                  @relation("Ersteller")
  tnMeldungen                         Fortbildung[]                  @relation("TnMeldung")
  teilnahmebestaetigungenReferenten   Fortbildung[]                  @relation("TeilnahmebestaetigungReferenten")
  teilnahmebestaetigungenTeilnehmende Fortbildung[]                  @relation("TeilnahmebestaetigungTeilnehmende")
  freigaben                           Fortbildung[]                  @relation("Freigabe")
  fibsEintraege                       Fortbildung[]                  @relation("FibsEintrag")
  auditLogs                           AuditLog[]
  zugangstoken                        Zugangstoken[]
  referentenRegistrierungslinks       ReferentenRegistrierungslink[] @relation("RegistrierungslinkErsteller")
  /// Gesetzt, wenn dieses Konto zu einer Referentin oder einem Referenten gehört
  referent                            Referent?
  /// Zuständigkeiten von BdBs und Redaktionskonten. RvS ist global.
  bezirke                             Bezirk[]
}

/// Einmal-Token für das Einrichten eines Zugangs und für das Zurücksetzen
/// eines Passworts.
///
/// Die Prüfung verwendet nur den Hash. Für erneut anzeigbare BdB-Links liegt
/// der Token zusätzlich verschlüsselt vor; der Schlüssel bleibt außerhalb der DB.
model Zugangstoken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  tokenVerschluesselt String? @db.Text
  userId    String
  zweck     String // EINLADUNG | PASSWORT_RESET
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Wiederverwendbarer, zeitlich begrenzter Link für die Selbstregistrierung
/// von Referentinnen und Referenten. Der Link selbst wird nie gespeichert;
/// `tokenHash` ist ein SHA-256-Hash des zufällig erzeugten Tokens.
model ReferentenRegistrierungslink {
  id              String    @id @default(uuid())
  tokenHash       String    @unique
  expiresAt       DateTime  @db.Timestamptz(3)
  aktiv           Boolean   @default(true)
  nutzungen       Int       @default(0)
  maxNutzungen    Int       @default(25)
  letzteNutzungAm DateTime? @db.Timestamptz(3)
  erstelltVonId   String?
  bezirkId        String
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  erstelltVon User?  @relation("RegistrierungslinkErsteller", fields: [erstelltVonId], references: [id], onDelete: SetNull)
  bezirk      Bezirk @relation(fields: [bezirkId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@index([aktiv, expiresAt])
  @@index([erstelltVonId])
  @@index([bezirkId])
}

/// Schulamtsbezirk, für den Fortbildungen ausgeschrieben werden.
model Bezirk {
  id                 String   @id @default(uuid())
  name               String   @unique
  aktiv              Boolean  @default(true)
  /// Bezirkseigene Pflichtschlagworte, die bei neuen Ausschreibungen ergänzt werden.
  pflichtSchlagworte String[] @default([])

  users                         User[]
  referenten                    Referent[]
  fortbildungen                 Fortbildung[]
  referentenRegistrierungslinks ReferentenRegistrierungslink[]
}

// ---------------------------------------------------------------------------
// Fortbildungen
// ---------------------------------------------------------------------------

model Fortbildung {
  id   String @id @default(uuid())
  /// Sprechende, stabile URL: "medienkonzept-erstellen-2026-09-15-a1b2"
  slug String @unique

  // --- Felder der Eingabemaske (FIBS-Feldlogik) ---
  titel            String
  kurztitel        String?
  /// Sanitisiertes HTML aus dem WYSIWYG-Editor (Allowlist in src/lib/sanitize.ts)
  beschreibungHtml String  @db.Text
  /// Aus dem HTML abgeleiteter Klartext — ausschließlich für die Volltextsuche
  beschreibungText String  @db.Text

  organisationsform String // SCHILF | REGIONAL (= RLFB) | ALP
  /// Geplante Höchstzahl an Teilnehmenden
  maxTn             Int
  format            String // ESESSION | PRAESENZ

  /// Immer als UTC gespeichert, immer in Europe/Berlin angezeigt
  beginn DateTime @db.Timestamptz(3)
  ende   DateTime @db.Timestamptz(3)

  veranstaltungsortId String
  /// Mehrfachauswahl, z. B. ["GRUNDSCHULE", "MITTELSCHULE"]
  schularten          String[]
  fach                String?

  // --- DigCompEdu Bavaria ---
  niveaustufe String? // NIVEAU_I_II | NIVEAU_III_IV | NIVEAU_V_VI

  // --- FIBS-Anbindung ---
  fibsLehrgangsnummer  String?
  fibsUrl              String?
  /// Ist die Fortbildung tatsächlich in FIBS ausgeschrieben? Bewusst ein
  /// eigenes Feld und nicht aus der Lehrgangsnummer abgeleitet: Eine Nummer
  /// kann vorgemerkt sein, bevor der Eintrag in FIBS wirklich steht.
  inFibs               Boolean   @default(false)
  fibsEingetragenAm    DateTime? @db.Timestamptz(3)
  fibsEingetragenVonId String?
  quelle               String    @default("MANUELL") // MANUELL | FIBS_IMPORT
  /// Fremdschlüssel der Quelle, dient dem Deduplizieren beim Import
  externalId           String?   @unique

  // --- Nachbereitung ---
  /// Tatsächliche Teilnehmerzahl, nach der Veranstaltung gemeldet.
  /// null bedeutet "noch nicht gemeldet", 0 bedeutet "niemand da gewesen".
  tnTatsaechlich                                   Int?
  tnGemeldetAm                                     DateTime? @db.Timestamptz(3)
  tnGemeldetVonId                                  String?
  /// Freitext der meldenden Person, z. B. "zwei kurzfristige Absagen"
  tnBemerkung                                      String?
  /// Bestätigung der Administration: Teilnahmebestätigungen wurden in FIBS
  /// für die Referierenden versandt. Es werden keine einzelnen Empfänger oder
  /// FIBS-Nachrichten gespeichert.
  teilnahmebestaetigungenReferentenVersandtAm      DateTime? @db.Timestamptz(3)
  teilnahmebestaetigungenReferentenVersandtVonId   String?
  /// Bestätigung der Administration: Teilnahmebestätigungen wurden in FIBS
  /// für die Teilnehmenden versandt. Es werden keine Teilnehmerdaten geführt.
  teilnahmebestaetigungenTeilnehmendeVersandtAm    DateTime? @db.Timestamptz(3)
  teilnahmebestaetigungenTeilnehmendeVersandtVonId String?

  // --- Freigabe ---
  /// ENTWURF | EINGEREICHT | VEROEFFENTLICHT | ABGESAGT | ARCHIVIERT
  ///
  /// EINGEREICHT liegt zwischen Entwurf und Veröffentlichung: Referentinnen
  /// und Referenten reichen dorthin ein, die Administration gibt frei. Öffentlich
  /// sichtbar sind weiterhin nur VEROEFFENTLICHT und ABGESAGT.
  status           String    @default("ENTWURF")
  eingereichtAm    DateTime? @db.Timestamptz(3)
  freigegebenAm    DateTime? @db.Timestamptz(3)
  freigegebenVonId String?
  /// Begründung bei einer Zurückweisung — die einreichende Person soll
  /// erfahren, was noch fehlt.
  freigabeNotiz    String?

  createdById String?
  /// Genau ein organisatorisch zuständiger Schulamtsbezirk.
  bezirkId    String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  veranstaltungsort                              Veranstaltungsort       @relation(fields: [veranstaltungsortId], references: [id])
  ersteller                                      User?                   @relation("Ersteller", fields: [createdById], references: [id], onDelete: SetNull)
  tnGemeldetVon                                  User?                   @relation("TnMeldung", fields: [tnGemeldetVonId], references: [id], onDelete: SetNull)
  teilnahmebestaetigungenReferentenVersandtVon   User?                   @relation("TeilnahmebestaetigungReferenten", fields: [teilnahmebestaetigungenReferentenVersandtVonId], references: [id], onDelete: SetNull)
  teilnahmebestaetigungenTeilnehmendeVersandtVon User?                   @relation("TeilnahmebestaetigungTeilnehmende", fields: [teilnahmebestaetigungenTeilnehmendeVersandtVonId], references: [id], onDelete: SetNull)
  freigegebenVon                                 User?                   @relation("Freigabe", fields: [freigegebenVonId], references: [id], onDelete: SetNull)
  fibsEingetragenVon                             User?                   @relation("FibsEintrag", fields: [fibsEingetragenVonId], references: [id], onDelete: SetNull)
  schlagworte                                    FortbildungSchlagwort[]
  kompetenzen                                    FortbildungKompetenz[]
  referenten                                     FortbildungReferent[]
  bezirk                                         Bezirk                  @relation(fields: [bezirkId], references: [id], onDelete: Restrict)

  @@index([beginn])
  @@index([status, beginn])
  @@index([organisationsform])
  @@index([veranstaltungsortId])
  @@index([bezirkId, beginn])
  @@index([teilnahmebestaetigungenReferentenVersandtAm])
  @@index([teilnahmebestaetigungenTeilnehmendeVersandtAm])
  @@index([schularten], type: Gin)
}

model Veranstaltungsort {
  id          String  @id @default(uuid())
  name        String
  ort         String?
  strasse     String?
  /// Amtliche Schulnummer, sofern bekannt
  schulnummer String?
  /// Genau ein Datensatz ("Online") trägt hier true — Pflicht für eSessions
  istOnline   Boolean @default(false)
  aktiv       Boolean @default(true)
  sortOrder   Int     @default(0)

  fortbildungen Fortbildung[]

  @@unique([name, ort])
}

// ---------------------------------------------------------------------------
// Schlagworte
// ---------------------------------------------------------------------------

model Schlagwort {
  id String @id @default(uuid())

  name           String   @unique
  /// Such- und Eindeutigkeitsschlüssel: klein geschrieben, ohne führende,
  /// nachlaufende oder mehrfache Leerzeichen. Die sichtbare Schreibweise bleibt
  /// in `name` erhalten, damit vorgeschlagene Schlagworte konsistent wirken.
  normalisiert   String   @unique
  /// "UAMM" und "Medienteam-UAMM": werden jeder Fortbildung automatisch
  /// angehängt und lassen sich im Formular nicht abwählen.
  istPflicht     Boolean  @default(false)
  /// Steuert, mit welchen Begriffen der FIBS-Import sucht (src/lib/fibs)
  fuerFibsImport Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  fortbildungen FortbildungSchlagwort[]
}

model FortbildungSchlagwort {
  fortbildungId String
  schlagwortId  String

  fortbildung Fortbildung @relation(fields: [fortbildungId], references: [id], onDelete: Cascade)
  schlagwort  Schlagwort  @relation(fields: [schlagwortId], references: [id], onDelete: Cascade)

  @@id([fortbildungId, schlagwortId])
  @@index([schlagwortId])
}

// ---------------------------------------------------------------------------
// DigCompEdu Bavaria
// ---------------------------------------------------------------------------

/// Der Kompetenzrahmen als selbstreferenzierender Baum:
///   code "3"   = Kompetenzbereich  (parentCode = null)
///   code "3.2" = Unterkompetenz    (parentCode = "3")
/// Titel und Struktur liegen damit an genau einer Stelle. Aktualisiert Bayern
/// den Rahmen, ist das ein Seed-Update statt eines Massen-Updates auf allen
/// Fortbildungen (wie es bei JSON-Feldern nötig wäre).
model DigCompKompetenz {
  code           String  @id
  parentCode     String?
  titel          String
  /// Kurzbeschreibung für Tooltips im Formular
  beschreibung   String?
  sortOrder      Int
  aktiv          Boolean @default(true)
  /// Markiert die im Rahmen noch nicht final ausformulierten Platzhalter
  istPlatzhalter Boolean @default(false)

  parent   DigCompKompetenz?  @relation("Kompetenzbaum", fields: [parentCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  children DigCompKompetenz[] @relation("Kompetenzbaum")

  fortbildungen FortbildungKompetenz[]

  @@index([parentCode, sortOrder])
}

model FortbildungKompetenz {
  fortbildungId String
  kompetenzCode String

  fortbildung Fortbildung      @relation(fields: [fortbildungId], references: [id], onDelete: Cascade)
  kompetenz   DigCompKompetenz @relation(fields: [kompetenzCode], references: [code], onDelete: Cascade, onUpdate: Cascade)

  @@id([fortbildungId, kompetenzCode])
  @@index([kompetenzCode])
}

// ---------------------------------------------------------------------------
// Referenten
//
// DSGVO: Das sind die einzigen personenbezogenen Daten des Systems (neben den
// Redaktions-Accounts). E-Mail und Telefon sind reine Innendaten und werden
// nie an das öffentliche Frontend ausgeliefert — siehe publicReferentSelect
// in src/lib/queries.ts.
// ---------------------------------------------------------------------------

model Referent {
  id                  String   @id @default(uuid())
  vorname             String
  nachname            String
  organisation        String?
  /// Nur intern sichtbar
  email               String?
  /// Nur intern sichtbar
  telefon             String?
  /// Interne Notiz, nie öffentlich
  notiz               String?
  /// Steuert, ob der Name im öffentlichen Frontend erscheint
  oeffentlichSichtbar Boolean  @default(true)
  aktiv               Boolean  @default(true)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  /// Verknüpftes Anmeldekonto. Referentinnen und Referenten ohne Konto sind
  /// weiterhin möglich — sie erscheinen dann nur im Verzeichnis.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  fortbildungen FortbildungReferent[]
  /// Eine Person kann für mehrere Schulamtsbezirke ausschreiben.
  bezirke       Bezirk[]

  @@index([nachname, vorname])
}

model FortbildungReferent {
  fortbildungId String
  referentId    String
  rolle         String? // z. B. "Leitung", "Co-Referent"

  fortbildung Fortbildung @relation(fields: [fortbildungId], references: [id], onDelete: Cascade)
  referent    Referent    @relation(fields: [referentId], references: [id], onDelete: Cascade)

  @@id([fortbildungId, referentId])
  @@index([referentId])
}

// ---------------------------------------------------------------------------
// FIBS-Import-Protokoll
// ---------------------------------------------------------------------------

model FibsImportJob {
  id            String    @id @default(uuid())
  startedAt     DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt    DateTime? @db.Timestamptz(3)
  status        String    @default("LAEUFT") // LAEUFT | ERFOLG | FEHLER | ABGEBROCHEN
  dryRun        Boolean   @default(true)
  suchbegriffe  String[]
  gefunden      Int       @default(0)
  neu           Int       @default(0)
  aktualisiert  Int       @default(0)
  uebersprungen Int       @default(0)
  fehlermeldung String?
  /// Vorschau-Daten des Dry-Runs, damit die Übernahme ohne zweiten Abruf geht
  rohdaten      Json?

  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// Rechenschaftspflicht (Art. 5 Abs. 2 DSGVO)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  at         DateTime @default(now()) @db.Timestamptz(3)
  userId     String?
  aktion     String // CREATE | UPDATE | DELETE | LOGIN | LOGIN_FAILED | IMPORT | RETENTION
  entitaet   String // "Fortbildung", "Referent", ...
  entitaetId String?
  /// Kurzbeschreibung bzw. geänderte Felder — bewusst ohne Volldaten-Kopie
  details    Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([entitaet, entitaetId])
}

/// Schlüssel-Wert-Speicher für redaktionelle Texte und Betriebs-Marker:
/// "impressum", "datenschutz", "lastRetentionRun"
model SystemSetting {
  id        String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
